# Application
APP_NAME="ISP Billing System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+psycopg2://user-isp-billing-system:%40Pat1muan%23123@localhost:5432/isp-billing-system
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Security
SECRET_KEY=isp-billing-system-super-secret-key-2024-production-ready-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["https://serveratech.biz.id", "http://localhost:3000"]

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@serveratech.biz.id
EMAIL_FROM_NAME="ISP Billing System"

# Payment Gateway
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_GATEWAY_API_KEY=your-api-key
PAYMENT_GATEWAY_SECRET=your-secret-key
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-secret

# MikroTik
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_SSL_PORT=8729
MIKROTIK_TIMEOUT=10

# RADIUS
RADIUS_SECRET=your-radius-secret
RADIUS_SERVER=localhost
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Asia/Jakarta

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/isp-billing
